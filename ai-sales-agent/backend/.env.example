# ── AI Sales Agent — Environment Configuration ─────────────────────

# App
APP_NAME=AI Sales Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── STT (Speech-to-Text) ───────────────────────────────────────────
STT_PROVIDER=whisper
# WHISPER_MODEL_SIZE: base, small, medium, large-v3, auto
WHISPER_MODEL_SIZE=base
WHISPER_CPU_THREADS=4

# ── STT: Deepgram (cloud, optional) ────────────────────────────────
# DEEPGRAM_API_KEY=

# ── LLM (Language Model) ───────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ── LLM: OpenAI (cloud, optional) ──────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── TTS (Text-to-Speech) ───────────────────────────────────────────
TTS_PROVIDER=kokoro
DEFAULT_VOICE_ID=af_bella
DEFAULT_LANGUAGE=en
DEFAULT_SPEAKING_RATE=1.0

# ── TTS: ElevenLabs (cloud, optional) ──────────────────────────────
# ELEVENLABS_API_KEY=

# ── Audio Cache ────────────────────────────────────────────────────
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_DIR=data/audio/cache
AUDIO_CACHE_WARM=true

# ── LiveKit (Realtime Voice Transport) ─────────────────────────────
LIVEKIT_ENABLED=false
LIVEKIT_SERVER_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# ── Twilio (Phone Integration) ─────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ── Embeddings (RAG + Memory) ─────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Auth ───────────────────────────────────────────────────────────
# AUTH_SECRET=your-jwt-secret-here

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SEC=60

# ── Redis (optional, for distributed state) ────────────────────────
# REDIS_URL=redis://localhost:6379

# ── Hardware ───────────────────────────────────────────────────────
TORCH_DEVICE=auto
CUDA_VISIBLE_DEVICES=
