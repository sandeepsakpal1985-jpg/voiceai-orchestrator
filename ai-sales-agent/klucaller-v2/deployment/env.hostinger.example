# Hostinger first deploy — copy to klucaller-v2/.env on the VPS
# cp deployment/env.hostinger.example .env
# NEVER commit .env or real secrets to Git.

# ── Public site ──────────────────────────────────────────
PUBLIC_HOST=klucaller.creamylane.com
PUBLIC_BASE_URL=https://klucaller.creamylane.com
CORS_ORIGINS=https://klucaller.creamylane.com

# Host port published for nginx upstream (avoid 80/443/8080)
KLUCALLER_HOST_PORT=8090
# Phase 1: localhost only. Phase 3 (nginx): set to 0.0.0.0 only after explicit approval.
KLUCALLER_BIND_HOST=127.0.0.1

# ── First boot: no RunPod required ───────────────────────
KLUCALLER_LLM=mock
KLUCALLER_STT=dev
KLUCALLER_TTS=stub
KLUCALLER_VAD=energy
KLUCALLER_LIVEKIT_AUDIO=0
KLUCALLER_TTS_SENTENCE_STREAM=1

# ── LiveKit (change secrets before public use) ───────────
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://klucaller.creamylane.com/livekit
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me
# Generate on VPS: openssl rand -hex 16 (key) and openssl rand -hex 32 (secret)
# Then update deployment/livekit.yaml keys section to match.

# ── RunPod GPU (fill when renting; leave empty for first smoke) ─
STT_SERVICE_URL=
TTS_SERVICE_URL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:14b-instruct
WHISPER_ALLOW_CPU=0

# When RunPod is up, switch to:
# KLUCALLER_STT=whisper
# KLUCALLER_TTS=kokoro-http
# KLUCALLER_LLM=ollama
# STT_SERVICE_URL=http://YOUR_RUNPOD_IP:9000
# TTS_SERVICE_URL=http://YOUR_RUNPOD_IP:9001
# OLLAMA_BASE_URL=http://YOUR_RUNPOD_IP:11434

# ── Database (optional — app uses in-memory by default) ─
# POSTGRES_USER=klucaller
# POSTGRES_PASSWORD=replace_me
# DATABASE_URL=postgresql://klucaller:replace_me@postgres:5432/klucaller
