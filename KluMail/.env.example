# Copy to .env.local. Never commit real values.
# `npm run db:up` generates .env.local for the project-local Postgres cluster.

APP_ENV=development
APP_URL=http://127.0.0.1:3000

# Superuser connection used only by migrations and the local cluster bootstrap.
DATABASE_ADMIN_URL=postgresql://klumail:change-me@127.0.0.1:5433/klumail

# Request path. Must be a non-superuser role without BYPASSRLS.
DATABASE_URL=postgresql://klumail_app:change-me@127.0.0.1:5433/klumail

# Background jobs and provider token storage. Server-only.
DATABASE_WORKER_URL=postgresql://klumail_worker:change-me@127.0.0.1:5433/klumail

# Login, sessions, password resets. Server-only.
DATABASE_AUTH_URL=postgresql://klumail_auth:change-me@127.0.0.1:5433/klumail

TEST_DATABASE_ADMIN_URL=postgresql://klumail:change-me@127.0.0.1:5433/klumail_test
TEST_DATABASE_URL=postgresql://klumail_app:change-me@127.0.0.1:5433/klumail_test
TEST_DATABASE_WORKER_URL=postgresql://klumail_worker:change-me@127.0.0.1:5433/klumail_test
TEST_DATABASE_AUTH_URL=postgresql://klumail_auth:change-me@127.0.0.1:5433/klumail_test

# 32-byte key, base64-encoded. Used for OAuth token encryption.
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Protects the internal job tick endpoint.
WORKER_SECRET=replace-with-a-long-random-string

BCRYPT_ROUNDS=12
SYNC_INITIAL_DAYS=14
PG_BIN=C:\Program Files\PostgreSQL\16\bin

# Optional. When unset, system emails are stored for local delivery only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KluMail <support@example.com>

# Optional. When unset, Gmail connect explains that credentials are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/google/callback
GOOGLE_PUBSUB_TOPIC=

# Optional. When unset, Microsoft 365 connect explains that credentials are required.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/microsoft/callback
MICROSOFT_TENANT=common
MICROSOFT_WEBHOOK_URL=

# Set to true to load the labeled Northwind demo workspace.
SEED_DEMO=false
