# ── SocialPilot AI — Production Environment ──
# Copy to .env.prod and fill in all secrets.
# NEVER commit this file to version control.

# ── Database ──
DB_PASSWORD=<generate-a-strong-password>
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/socialpilot

# ── Redis ──
REDIS_PASSWORD=<generate-a-strong-password>
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ── Qdrant ──
QDRANT_URL=http://qdrant:6333

# ── JWT ──
JWT_SECRET=<generate-a-strong-random-secret>
JWT_EXPIRES_IN=7d

# ── Meta (Facebook/Instagram) OAuth ──
META_APP_ID=<your-meta-app-id>
META_APP_SECRET=<your-meta-app-secret>
META_WEBHOOK_VERIFY_TOKEN=<generate-a-random-token>
META_CALLBACK_URL=https://api.yourdomain.com/api/meta/callback

# ── OpenAI ──
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

# ── Frontend URL (for OAuth redirects) ──
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ── Sentry (Error Tracking) — Optional ──
SENTRY_DSN=<your-sentry-dsn>

# ── PostHog (Analytics) — Optional ──
POSTHOG_API_KEY=<your-posthog-api-key>
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=<your-posthog-client-key>
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Resend (Transactional Email) — Optional ──
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=noreply@yourdomain.com

# ── Razorpay (Subscriptions) — Optional ──
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<your-razorpay-webhook-secret>
