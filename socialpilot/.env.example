# ---
# MetaPilot AI - Environment Configuration
# Copy this file to .env and fill in your values
# ---

## Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

## Auth
JWT_SECRET=change-me-to-a-random-64-char-string
AUTH_SECRET=change-me-to-a-random-secret
AUTH_BYPASS=false

## Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialpilot

## Redis
REDIS_URL=redis://localhost:6379

## OpenAI (AI Engine)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

## Meta / Facebook (Instagram + Facebook API)
META_CLIENT_ID=your-meta-app-id
META_CLIENT_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-meta-app-secret-for-webhook-signature

## Razorpay (Subscription Billing)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

## Resend (Transactional Email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@your-domain.com

## Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

## PostHog (Product Analytics)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_API_KEY=phx_...

## Sentry (Error Monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://...
SENTRY_DSN=https://...
SENTRY_ENVIRONMENT=development

## LiveKit (Future: Real-time Voice)
LIVEKIT_ENABLED=false
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

## Twilio (Future: SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

## Chatwoot (OSS Inbox Bridge)
CHATWOOT_BASE_URL=
CHATWOOT_API_KEY=
CHATWOOT_ACCOUNT_ID=

## n8n (Workflow Automation Bridge)
N8N_BASE_URL=
N8N_API_KEY=

## Supabase (File Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=socialpilot

## Qdrant (Vector Store - RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

## Ollama (Local LLM Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

## Mem0 (Semantic Memory)
MEM0_API_KEY=
MEM0_USER_ID=

## Misc
DEMO_MODE=false
ENFORCE_SUBSCRIPTIONS=false
DISABLE_WEBHOOK_VERIFICATION=false
